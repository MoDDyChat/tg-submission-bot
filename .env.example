BOT__TOKEN=your_bot_token_here

DB__HOST=postgres
DB__PORT=5432
DB__NAME=tg_submission_bot
DB__USER=postgres
DB__PASSWORD=your_secure_password

# Bootstrap moderator list (additive, break-glass). These IDs are seeded with
# is_moderator=True at startup; the DB is the source of truth at runtime.
# Removing an ID from this list does NOT demote the person — the roster UI
# (ADMIN-only) manages runtime roles. For several, list them comma-separated:
#   MODERATOR_IDS=123456789,987654321,555444333
MODERATOR_IDS=123456789

CHANNEL_ID=-100xxxxxxxxxx

# The forum group (with topics enabled) used for moderation
MODERATOR_GROUP_ID=-100xxxxxxxxxx

# Bootstrap admin list (additive, break-glass). An admin is a moderator with
# extra rights, so listing an ID here is enough - it does not have to be
# repeated in MODERATOR_IDS. The DB is the source of truth at runtime; removing
# an ID here does NOT revoke admin from the person.
# Empty means no admins seeded from config.
# ADMIN_IDS=123456789

TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# File holding the submission rules (the /start text shown to viewers).
# Defaults to config/rules.txt
RULES_PATH=config/rules.txt

# Redis keeps the FSM state across bot restarts.
# The docker-compose setup already includes a redis service.
REDIS_URL=redis://redis:6379/0

# TTL of the edit lock (seconds, 5 minutes by default)
# EDIT_LOCK_TTL_SECONDS=300

# SOCKS5/HTTP proxy for reaching the Telegram API (optional)
# PROXY_URL=socks5://user:password@host:1080
# PROXY_URL=socks5://host:1080

# Silent notifications for moderators (moderation group + admin DMs), no push ping.
# false - bring the sound back.
# SILENT_MODERATOR_NOTIFICATIONS=true

# Hashtag parsing from the post caption on intake: off - do not parse,
# suggest - store author hashtags into suggested_tags for the moderator wizard,
# auto - also write exact preset matches into the post tags.
# TAG_PARSING_MODE=suggest
# Strip bare hashtag-only lines from the caption (kept: a post made only of
# hashtags stays unchanged).
# TAG_PARSING_STRIP_FROM_CAPTION=false

# HTTP server for health/metrics (docker healthcheck + vmagent scrape)
# API_HOST=0.0.0.0
# API_PORT=5400

# Apply migrations automatically on bot startup.
# false - check only: if the schema lags behind head, the bot refuses to start.
# DB_AUTO_MIGRATE=true
# Migration run timeout, in seconds
# DB_MIGRATE_TIMEOUT=300
