BOT__TOKEN=your_bot_token_here

DB__HOST=postgres
DB__PORT=5432
DB__NAME=tg_submission_bot
DB__USER=postgres
DB__PASSWORD=your_secure_password

# Один или несколько ID модераторов через запятую
MODERATOR_IDS=123456789
# MODERATOR_IDS=123456789,987654321

CHANNEL_ID=-100xxxxxxxxxx

# Группа с темами-форумом для модерации
MODERATOR_GROUP_ID=-100xxxxxxxxxx

# ID администраторов (подмножество MODERATOR_IDS; пусто — нет админов)
# ADMIN_IDS=123456789

TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Путь к файлу с текстом правил предложки (текст /start для вьюеров).
# По умолчанию config/rules.txt
RULES_PATH=config/rules.txt

# Redis для сохранения FSM state между перезапусками бота.
# При использовании docker-compose сервис redis уже включён.
REDIS_URL=redis://redis:6379/0

# TTL блокировки редактирования (секунды, по умолчанию 5 минут)
# EDIT_LOCK_TTL_SECONDS=300

# SOCKS5/HTTP прокси для подключения к Telegram API (опционально)
# PROXY_URL=socks5://user:password@host:1080
# PROXY_URL=socks5://host:1080

# Тихие уведомления модераторам (модгруппа + DM админам), без пуш-пинга.
# false — вернуть звук.
# SILENT_MODERATOR_NOTIFICATIONS=true

# HTTP-сервер health/metrics (docker healthcheck + скрейп vmagent)
# API_HOST=0.0.0.0
# API_PORT=5400

# Автоприменение миграций при старте бота.
# false — только проверка: если схема отстаёт от head, бот не стартует.
# DB_AUTO_MIGRATE=true
# Таймаут прогона миграций в секундах
# DB_MIGRATE_TIMEOUT=300
